---
import type { Project } from '../lib/sanity';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Background decoration - Optimized blur -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-accent/10 rounded-full blur-2xl"></div>
    <div class="absolute bottom-1/4 left-0 w-72 h-72 bg-primary/10 rounded-full blur-2xl"></div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="section-title">
        Proyek <span class="gradient-text">Unggulan</span>
      </h2>
      <p class="section-subtitle max-w-2xl mx-auto">
        Pencapaian dan proyek yang telah saya kerjakan
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8">
      {projects.map((project, index) => (
        <div class={`project-card group ${project.featured ? 'md:col-span-2 lg:col-span-1' : ''}`}>
          <div class="card h-full flex flex-col overflow-hidden border border-transparent hover:border-primary/30 transition-all duration-500">
            <!-- Project Image -->
            <div 
              class="relative h-48 md:h-56 overflow-hidden rounded-xl mb-6 bg-gradient-to-br from-primary/20 via-secondary/20 to-accent/20 cursor-pointer project-image-container"
              data-image={project.image?.asset?.url || ''}
              data-title={project.title}
            >
              {project.image?.asset?.url ? (
                <img 
                  src={project.image.asset.url} 
                  alt={project.title}
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-6xl font-display font-bold opacity-20">
                    {project.title.charAt(0)}
                  </div>
                </div>
              )}
              
              <!-- Overlay on hover with zoom icon -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center transform scale-0 group-hover:scale-100 transition-transform duration-300">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </div>
              
              {project.featured && (
                <div class="absolute top-4 right-4 z-10">
                  <span class="px-3 py-1 text-xs font-medium bg-primary text-white rounded-full shadow-lg">
                    Unggulan
                  </span>
                </div>
              )}
            </div>
            
            <!-- Content -->
            <div class="flex-1 flex flex-col">
              <h3 class="text-xl font-display font-semibold mb-3 group-hover:text-primary transition-colors">
                {project.title}
              </h3>
              
              <p class="opacity-80 mb-4 flex-1 leading-relaxed">
                {project.description}
              </p>
              
              <!-- Technologies -->
              <div class="flex flex-wrap gap-2 mt-auto">
                {project.technologies.map((tech) => (
                  <span class="px-3 py-1 text-xs font-medium dark:bg-dark-bg bg-gray-100 rounded-full">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- View More Button -->
    <div class="text-center mt-12">
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary inline-flex items-center gap-2"
      >
        <span>Lihat Semua Proyek</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
  
  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/90 backdrop-blur-sm">
    <button id="lightbox-close" class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors z-10">
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="relative max-w-5xl w-full">
      <img id="lightbox-image" src="" alt="" class="w-full h-auto max-h-[85vh] object-contain rounded-2xl shadow-2xl" />
      <p id="lightbox-title" class="text-white text-center mt-4 text-xl font-display font-semibold"></p>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../lib/animations';
  
  // Set initial states
  gsap.set('.project-card', { opacity: 0, y: 40 });
  
  // Single ScrollTrigger for Projects section
  ScrollTrigger.create({
    trigger: '#projects',
    start: 'top 75%',
    once: true,
    onEnter: () => {
      gsap.to('.project-card', {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.12,
        ease: 'power2.out',
      });
    },
  });
  
  // Lightbox functionality
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title') as HTMLElement;
  const lightboxClose = document.getElementById('lightbox-close') as HTMLButtonElement;
  const imageContainers = document.querySelectorAll('.project-image-container');
  
  // Open lightbox
  imageContainers.forEach((container) => {
    container.addEventListener('click', () => {
      const imageUrl = container.getAttribute('data-image');
      const title = container.getAttribute('data-title');
      
      if (imageUrl) {
        lightboxImage.src = imageUrl;
        lightboxImage.alt = title || '';
        lightboxTitle.textContent = title || '';
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
        
        // Animate in
        gsap.fromTo(lightbox, 
          { opacity: 0 }, 
          { opacity: 1, duration: 0.3, ease: 'power2.out' }
        );
        gsap.fromTo(lightboxImage, 
          { scale: 0.8, opacity: 0 }, 
          { scale: 1, opacity: 1, duration: 0.4, ease: 'back.out(1.7)', delay: 0.1 }
        );
      }
    });
  });
  
  // Close lightbox
  const closeLightbox = () => {
    gsap.to(lightbox, {
      opacity: 0,
      duration: 0.2,
      ease: 'power2.in',
      onComplete: () => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }
    });
  };
  
  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  
  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>
