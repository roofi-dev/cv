---
const currentYear = new Date().getFullYear();
---

<footer class="py-8 border-t dark:border-white/10 border-black/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="text-2xl font-display font-bold gradient-text">JD</span>
        <span class="opacity-60">|</span>
        <span class="text-sm opacity-60">Full Stack Developer</span>
      </div>
      
      <p class="text-sm opacity-60 text-center">
        © {currentYear} John Doe. All rights reserved.
      </p>
      
      <div class="flex items-center gap-4">
        <a href="#home" class="text-sm opacity-60 hover:opacity-100 hover:text-primary transition-all">
          Back to top
        </a>
      </div>
    </div>
  </div>
</footer>
