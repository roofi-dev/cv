---
import type { PersonalInfo, Education } from '../lib/sanity';

interface Props {
  info: PersonalInfo;
  education: Education[];
}

const { info, education } = Astro.props;
---

<section id="about" class="py-20 lg:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="section-title">
        Tentang <span class="gradient-text">Saya</span>
      </h2>
      <p class="section-subtitle max-w-2xl mx-auto">
        Kenali lebih lanjut tentang latar belakang, pendidikan, dan motivasi saya
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <!-- About Content -->
      <div class="about-content space-y-6">
        <div class="card ">
          <h3 class="text-xl font-display font-semibold mb-4 flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </span>
            Siapa Saya
          </h3>
          <div class="opacity-80 leading-relaxed whitespace-pre-line">
            {info.aboutBio || info.bio}
          </div>
        </div>
        
        <div class="card ">
          <h3 class="text-xl font-display font-semibold mb-4 flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            Lokasi
          </h3>
          <p class="opacity-80">{info.location || 'Remote'}</p>
        </div>
        
        <div class="card ">
          <h3 class="text-xl font-display font-semibold mb-4 flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            Kontak
          </h3>
          <div class="space-y-2">
            <p class="opacity-80">{info.email}</p>
            {info.phone && <p class="opacity-80">{info.phone}</p>}
          </div>
        </div>
        
        <div class="card ">
          <h3 class="text-xl font-display font-semibold mb-4 flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-green-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </span>
            Keahlian Soft Skill
          </h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1.5 text-sm font-medium bg-green-500/10 text-green-600 dark:text-green-400 rounded-full">Leadership & Team Management</span>
            <span class="px-3 py-1.5 text-sm font-medium bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full">Communication & Negotiation</span>
            <span class="px-3 py-1.5 text-sm font-medium bg-purple-500/10 text-purple-600 dark:text-purple-400 rounded-full">Problem Solving</span>
            <span class="px-3 py-1.5 text-sm font-medium bg-orange-500/10 text-orange-600 dark:text-orange-400 rounded-full">Time Management</span>
          </div>
        </div>
      </div>
      
      <!-- Education -->
      <div class="about-education">
        <div class="card ">
          <h3 class="text-xl font-display font-semibold mb-6 flex items-center gap-3">
            <span class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
            </span>
            Pendidikan
          </h3>
          
          <div class="space-y-6">
            {education.map((edu, index) => (
              <div class="relative pl-6 border-l-2 border-primary/30 education-item">
                <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-primary"></div>
                <h4 class="font-semibold text-lg">{edu.degree} {edu.field}</h4>
                <p class="text-primary font-medium">{edu.institution}</p>
                <p class="text-sm opacity-60 mt-1">
                  {edu.startDate} - {edu.endDate || 'Sekarang'}
                </p>
                {edu.description && (
                  <p class="mt-2 opacity-80 text-sm">{edu.description}</p>
                )}
              </div>
            ))}
          </div>
        </div>
        
        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4 mt-6">
          <div class="card  text-center stat-card">
            <div class="text-3xl font-display font-bold gradient-text">5+</div>
            <div class="text-sm opacity-70 mt-1">Tahun Pengalaman</div>
          </div>
          <div class="card  text-center stat-card">
            <div class="text-3xl font-display font-bold gradient-text">50+</div>
            <div class="text-sm opacity-70 mt-1">Proyek Selesai</div>
          </div>
          <div class="card  text-center stat-card">
            <div class="text-3xl font-display font-bold gradient-text">30+</div>
            <div class="text-sm opacity-70 mt-1">Klien Puas</div>
          </div>
          <div class="card  text-center stat-card">
            <div class="text-3xl font-display font-bold gradient-text">10+</div>
            <div class="text-sm opacity-70 mt-1">Teknologi</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../lib/animations';
  
  // Set initial states
  gsap.set('.about-content .card', { opacity: 0, x: -30 });
  gsap.set('.about-education', { opacity: 0, x: 30 });
  gsap.set('.education-item', { opacity: 0, y: 15 });
  gsap.set('.stat-card', { opacity: 0, scale: 0.9 });
  
  // Single ScrollTrigger for About section
  ScrollTrigger.create({
    trigger: '#about',
    start: 'top 75%',
    once: true,
    onEnter: () => {
      // Animate content cards
      gsap.to('.about-content .card', {
        opacity: 1,
        x: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power2.out',
      });
      
      // Animate education section
      gsap.to('.about-education', {
        opacity: 1,
        x: 0,
        duration: 0.6,
        delay: 0.2,
        ease: 'power2.out',
      });
      
      // Animate education items
      gsap.to('.education-item', {
        opacity: 1,
        y: 0,
        duration: 0.5,
        stagger: 0.1,
        delay: 0.3,
        ease: 'power2.out',
      });
      
      // Animate stat cards
      gsap.to('.stat-card', {
        opacity: 1,
        scale: 1,
        duration: 0.4,
        stagger: 0.08,
        delay: 0.4,
        ease: 'back.out(1.5)',
      });
    },
  });
</script>
