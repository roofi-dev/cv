---
import type { PersonalInfo } from '../lib/sanity';

interface Props {
  info: PersonalInfo;
}

const { info } = Astro.props;
---

<section id="contact" class="py-20 lg:py-32 relative">
  <!-- Background decoration - Optimized blur -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute bottom-0 left-1/2 w-[800px] h-[400px] bg-gradient-to-t from-primary/10 to-transparent rounded-full blur-2xl transform -translate-x-1/2"></div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <h2 class="section-title">
        Hubungi <span class="gradient-text">Saya</span>
      </h2>
      <p class="section-subtitle max-w-2xl mx-auto">
        Punya proyek atau ingin berkolaborasi? Jangan ragu untuk menghubungi saya!
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
      <!-- Contact Info -->
      <div class="contact-info space-y-6">
        <div class="card">
          <h3 class="text-xl font-display font-semibold mb-6">Informasi Kontak</h3>
          
          <div class="space-y-4">
            <a href={`mailto:${info.email}`} class="contact-link group">
              <div class="contact-link-icon email-icon">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="contact-link-text">
                <p class="contact-label">Email</p>
                <p class="contact-value">{info.email}</p>
              </div>
              <svg class="w-5 h-5 opacity-0 group-hover:opacity-100 transition-opacity ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            
            {info.location && (
              <div class="contact-link">
                <div class="contact-link-icon location-icon">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="contact-link-text">
                  <p class="contact-label">Lokasi</p>
                  <p class="contact-value">{info.location}</p>
                </div>
              </div>
            )}
          </div>
          
          <!-- Social Links -->
          {info.socialLinks && info.socialLinks.length > 0 && (
            <div class="mt-8 pt-6 border-t dark:border-white/10 border-black/10">
              <p class="text-sm opacity-60 mb-4">Terhubung dengan saya</p>
              <div class="flex gap-3">
                {info.socialLinks.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center hover:bg-primary hover:text-white transition-all duration-300 hover:-translate-y-1"
                    aria-label={social.platform}
                  >
                    {social.platform === 'github' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    )}
                    {social.platform === 'linkedin' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                      </svg>
                    )}
                    {social.platform === 'twitter' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
      
      <!-- Call to Action -->
      <div class="contact-form">
        <div class="card text-center">
          <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          
          <h3 class="text-2xl font-display font-bold mb-3">Mari Berkolaborasi!</h3>
          <p class="opacity-70 mb-8 max-w-sm mx-auto">
            Tertarik untuk bekerja sama atau punya pertanyaan? Saya senang mendengar dari Anda.
          </p>
          
          <div class="space-y-4">
            <a 
              href={`mailto:${info.email}?subject=Halo Firdha - Dari Website CV`}
              class="btn-primary w-full flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Kirim Email</span>
            </a>
            
            <a 
              href="https://www.linkedin.com/in/roofi/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary w-full flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>Hubungi via LinkedIn</span>
            </a>
          </div>
          
          <p class="mt-8 text-sm opacity-50">
            Biasanya merespon dalam 24 jam
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../lib/animations';
  
  // Set initial states
  gsap.set('.contact-info', { opacity: 0, x: -30 });
  gsap.set('.contact-form', { opacity: 0, x: 30 });
  
  // Single ScrollTrigger for Contact section
  ScrollTrigger.create({
    trigger: '#contact',
    start: 'top 75%',
    once: true,
    onEnter: () => {
      gsap.to('.contact-info', {
        opacity: 1,
        x: 0,
        duration: 0.6,
        ease: 'power2.out',
      });
      
      gsap.to('.contact-form', {
        opacity: 1,
        x: 0,
        duration: 0.6,
        delay: 0.15,
        ease: 'power2.out',
      });
    },
  });
  
  </script>

<style>
  .contact-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    transition: all 0.3s ease;
    text-decoration: none;
    border: 1px solid transparent;
  }
  
  /* Light mode */
  .contact-link {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-color: #e2e8f0;
    color: #1e293b;
  }
  
  .contact-link:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
    border-color: #6366f1;
  }
  
  /* Dark mode */
  :global(.dark) .contact-link {
    background: linear-gradient(135deg, #334155 0%, #1e293b 100%);
    border-color: #475569;
    color: #f1f5f9;
  }
  
  :global(.dark) .contact-link:hover {
    background: linear-gradient(135deg, #3b4f6b 0%, #2d3f58 100%);
    border-color: #6366f1;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.25);
  }
  
  .contact-link-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  
  .email-icon {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: white;
  }
  
  .location-icon {
    background: linear-gradient(135deg, #14b8a6 0%, #06b6d4 100%);
    color: white;
  }
  
  .contact-link:hover .contact-link-icon {
    transform: scale(1.1);
  }
  
  .contact-label {
    font-size: 0.75rem;
    opacity: 0.6;
    margin-bottom: 0.125rem;
  }
  
  .contact-value {
    font-weight: 500;
    font-size: 0.95rem;
  }
  
  /* Social links styling */
  :global(.dark) .social-link {
    background: #334155;
    color: #f1f5f9;
  }
</style>
