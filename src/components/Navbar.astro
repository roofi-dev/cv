---
const navLinks = [
  { href: '#home', label: 'Beranda' },
  { href: '#about', label: 'Tentang' },
  { href: '#skills', label: 'Keahlian' },
  { href: '#experience', label: 'Pengalaman' },
  { href: '#projects', label: 'Proyek' },
  { href: '#contact', label: 'Kontak' },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="#home" class="text-2xl font-display font-bold gradient-text">
        FRI
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {navLinks.map((link) => (
          <a href={link.href} class="nav-link">
            {link.label}
          </a>
        ))}
        
        <!-- Dark Mode Toggle -->
        <button
          id="theme-toggle"
          class="ml-4 p-2 rounded-lg transition-colors duration-300 hover:bg-primary/10"
          aria-label="Toggle dark mode"
        >
          <svg id="sun-icon" class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="moon-icon" class="w-6 h-6 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
      
      <!-- Mobile Menu Button -->
      <div class="flex items-center md:hidden">
        <button
          id="theme-toggle-mobile"
          class="p-2 rounded-lg transition-colors duration-300 hover:bg-primary/10 mr-2"
          aria-label="Toggle dark mode"
        >
          <svg class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-6 h-6 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        
        <button
          id="mobile-menu-btn"
          class="p-2 rounded-lg transition-colors duration-300 hover:bg-primary/10"
          aria-label="Open menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden">
    <div class="px-4 pt-2 pb-4 space-y-1 dark:bg-dark-surface/95 bg-light-surface/95 backdrop-blur-lg border-t dark:border-white/10 border-black/10">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 rounded-lg transition-colors duration-300 hover:bg-primary/10 hover:text-primary"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Theme toggle functionality
  const themeToggle = document.getElementById('theme-toggle');
  const themeToggleMobile = document.getElementById('theme-toggle-mobile');
  
  const toggleTheme = () => {
    document.dispatchEvent(new CustomEvent('theme-toggle'));
  };
  
  themeToggle?.addEventListener('click', toggleTheme);
  themeToggleMobile?.addEventListener('click', toggleTheme);
  
  // Mobile menu functionality
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
  
  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
  
  // Navbar theme and scroll effect
  const navbar = document.getElementById('navbar');
  
  const updateNavbarTheme = () => {
    const isDark = document.documentElement.classList.contains('dark');
    const navLinks = navbar?.querySelectorAll('.nav-link');
    const icons = navbar?.querySelectorAll('svg');
    
    // Select all elements that need dark mode styling
    const cards = document.querySelectorAll('.card');
    const skillTags = document.querySelectorAll('.skill-tag');
    const techTags = document.querySelectorAll('.project-card span[class*="rounded-full"]');
    const contactItems = document.querySelectorAll('.contact-item');
    const socialLinks = document.querySelectorAll('.contact-info a[class*="w-12"]');
    const heroSocialLinks = document.querySelectorAll('.hero-social a');
    
    if (isDark) {
      // Update navbar
      navbar?.style.setProperty('background-color', '#0f172a');
      navLinks?.forEach(link => (link as HTMLElement).style.setProperty('color', '#ffffff'));
      icons?.forEach(icon => (icon as HTMLElement).style.setProperty('color', '#ffffff'));
      
      // Update body & sections
      document.body.style.setProperty('background-color', '#0f172a');
      document.body.style.setProperty('color', '#ffffff');
      document.querySelectorAll('section').forEach(section => {
        (section as HTMLElement).style.setProperty('background-color', '#0f172a');
        (section as HTMLElement).style.setProperty('color', '#ffffff');
      });
      
      // Update cards
      cards.forEach(card => {
        (card as HTMLElement).style.setProperty('background-color', '#1e293b');
        (card as HTMLElement).style.setProperty('color', '#ffffff');
      });
      
      // Update skill tags (sertifikasi)
      skillTags.forEach(tag => {
        (tag as HTMLElement).style.setProperty('background-color', '#1e293b');
        (tag as HTMLElement).style.setProperty('color', '#ffffff');
      });
      
      // Update tech tags in projects - darker shade but visible oval
      techTags.forEach(tag => {
        (tag as HTMLElement).style.setProperty('background-color', '#334155');
        (tag as HTMLElement).style.setProperty('color', '#ffffff');
      });
      
      // Contact items use CSS classes for hover effect - no JS override needed
      
      // Update social links
      socialLinks.forEach(link => {
        (link as HTMLElement).style.setProperty('background-color', '#1e293b');
        (link as HTMLElement).style.setProperty('color', '#ffffff');
      });
      
      // Update hero social links
      heroSocialLinks.forEach(link => {
        (link as HTMLElement).style.setProperty('background-color', '#1e293b');
        (link as HTMLElement).style.setProperty('color', '#ffffff');
      });
    } else {
      // Update navbar
      navbar?.style.setProperty('background-color', '#ffffff');
      navLinks?.forEach(link => (link as HTMLElement).style.setProperty('color', '#1e293b'));
      icons?.forEach(icon => (icon as HTMLElement).style.setProperty('color', '#1e293b'));
      
      // Update body & sections
      document.body.style.setProperty('background-color', '#f8fafc');
      document.body.style.setProperty('color', '#1e293b');
      document.querySelectorAll('section').forEach(section => {
        (section as HTMLElement).style.setProperty('background-color', '#f8fafc');
        (section as HTMLElement).style.setProperty('color', '#1e293b');
      });
      
      // Update cards
      cards.forEach(card => {
        (card as HTMLElement).style.setProperty('background-color', '#ffffff');
        (card as HTMLElement).style.setProperty('color', '#1e293b');
      });
      
      // Update skill tags
      skillTags.forEach(tag => {
        (tag as HTMLElement).style.setProperty('background-color', '#ffffff');
        (tag as HTMLElement).style.setProperty('color', '#1e293b');
      });
      
      // Update tech tags
      techTags.forEach(tag => {
        (tag as HTMLElement).style.setProperty('background-color', '#f1f5f9');
        (tag as HTMLElement).style.setProperty('color', '#1e293b');
      });
      
      // Contact items use CSS classes - no JS override needed
      
      // Update social links
      socialLinks.forEach(link => {
        (link as HTMLElement).style.setProperty('background-color', '#f3f4f6');
        (link as HTMLElement).style.setProperty('color', '#1e293b');
      });
      
      // Update hero social links
      heroSocialLinks.forEach(link => {
        (link as HTMLElement).style.setProperty('background-color', '#ffffff');
        (link as HTMLElement).style.setProperty('color', '#1e293b');
      });
    }
  };
  
  // Initial theme
  updateNavbarTheme();
  
  // Listen for theme changes
  document.addEventListener('theme-toggle', updateNavbarTheme);
  
  // Observe class changes on html element
  const observer = new MutationObserver(updateNavbarTheme);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>
