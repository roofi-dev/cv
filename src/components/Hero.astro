---
import type { PersonalInfo } from '../lib/sanity';

interface Props {
  info: PersonalInfo;
}

const { info } = Astro.props;
---

<section id="home" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
  <!-- Background Elements - Optimized with reduced blur and GPU layers -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="hero-bg-blob absolute top-1/4 left-1/4 w-96 h-96 bg-primary/15 rounded-full blur-2xl"></div>
    <div class="hero-bg-blob absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary/15 rounded-full blur-2xl"></div>
    <div class="hero-bg-blob absolute top-1/2 left-1/2 w-64 h-64 bg-accent/15 rounded-full blur-2xl"></div>
  </div>
  
  <!-- Grid Pattern -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(99,102,241,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(99,102,241,0.03)_1px,transparent_1px)] bg-[size:50px_50px]"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left" id="hero-content">
        <div class="inline-flex items-center px-4 py-2 rounded-full dark:bg-primary/10 bg-primary/5 border border-primary/20 mb-6 hero-badge">
          <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
          <span class="text-sm font-medium">Tersedia untuk peluang baru</span>
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mb-6 hero-title">
          Halo, Saya <span class="gradient-text">{info.name}</span>
        </h1>
        
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-medium mb-6 opacity-80 hero-subtitle">
          {info.title}
        </h2>
        
        <p class="text-lg opacity-70 mb-8 max-w-xl mx-auto lg:mx-0 hero-description">
          {info.bio}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start hero-buttons">
          <a href="#contact" class="btn-primary inline-flex items-center justify-center gap-2">
            <span>Hubungi Saya</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#projects" class="btn-secondary inline-flex items-center justify-center gap-2">
            <span>Lihat Proyek</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
        
        <!-- Social Links -->
        {info.socialLinks && info.socialLinks.length > 0 && (
          <div class="flex gap-4 mt-8 justify-center lg:justify-start hero-social">
            {info.socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-lg dark:bg-dark-surface bg-light-surface shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 hover:text-primary"
                aria-label={social.platform}
              >
                {social.platform === 'github' && (
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                )}
                {social.platform === 'linkedin' && (
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                )}
                {social.platform === 'twitter' && (
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
              </a>
            ))}
          </div>
        )}
      </div>
      
      <!-- Lottie Animation Container -->
      <div class="relative flex justify-center lg:justify-end" id="hero-visual">
        <div class="relative w-80 h-80 lg:w-96 lg:h-96">
          <!-- Decorative rings - Static for better performance -->
          <div class="absolute inset-0 rounded-full border-2 border-primary/20"></div>
          <div class="absolute inset-4 rounded-full border-2 border-secondary/20"></div>
          <div class="absolute inset-8 rounded-full border-2 border-accent/20"></div>
          
          <!-- Lottie container -->
          <div id="hero-lottie" class="absolute inset-12 flex items-center justify-center">
            <canvas id="lottie-canvas" class="w-full h-full"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#about" class="flex flex-col items-center gap-2 opacity-50 hover:opacity-100 transition-opacity">
      <span class="text-sm">Gulir ke Bawah</span>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from '../lib/animations';
  import { DotLottie } from '@lottiefiles/dotlottie-web';
  
  // Initialize Lottie animation with performance optimizations
  const canvas = document.getElementById('lottie-canvas') as HTMLCanvasElement;
  let lottieInstance: DotLottie | null = null;
  
  if (canvas) {
    // Set canvas size for better performance (avoid scaling)
    const size = Math.min(canvas.parentElement?.clientWidth || 300, 300);
    canvas.width = size;
    canvas.height = size;
    
    lottieInstance = new DotLottie({
      canvas,
      src: 'https://lottie.host/4db68bbd-31f6-4cd8-84eb-189571c8e5d0/RIpzm2HEgN.lottie',
      loop: true,
      autoplay: true,
      speed: 0.8, // Slightly slower for smoother appearance
    });
    
    // Pause Lottie when not visible (Intersection Observer)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (lottieInstance) {
          if (entry.isIntersecting) {
            lottieInstance.play();
          } else {
            lottieInstance.pause();
          }
        }
      });
    }, { threshold: 0.1 });
    
    observer.observe(canvas);
  }
  
  // Animate background blobs with GSAP (more performant than CSS animation)
  gsap.to('.hero-bg-blob', {
    scale: 1.1,
    duration: 4,
    ease: 'sine.inOut',
    yoyo: true,
    repeat: -1,
    stagger: 1.5,
  });
  
  // Optimized GSAP timeline for hero section (single timeline = better performance)
  const heroTl = gsap.timeline({
    defaults: { 
      ease: 'power3.out',
      duration: 0.7,
    }
  });
  
  // Set initial states (prevents flash of unstyled content)
  gsap.set(['.hero-badge', '.hero-title', '.hero-subtitle', '.hero-description', '.hero-buttons', '.hero-social'], {
    opacity: 0,
    y: 30,
  });
  gsap.set('#hero-visual', { opacity: 0, scale: 0.9 });
  
  // Animate in sequence using timeline (more performant than individual tweens)
  heroTl
    .to('.hero-badge', { opacity: 1, y: 0, duration: 0.5 }, 0.1)
    .to('.hero-title', { opacity: 1, y: 0 }, 0.2)
    .to('.hero-subtitle', { opacity: 1, y: 0 }, 0.35)
    .to('.hero-description', { opacity: 1, y: 0 }, 0.5)
    .to('.hero-buttons', { opacity: 1, y: 0 }, 0.65)
    .to('.hero-social', { opacity: 1, y: 0 }, 0.8)
    .to('#hero-visual', { 
      opacity: 1, 
      scale: 1, 
      duration: 0.9,
      ease: 'back.out(1.4)' 
    }, 0.3);
</script>
